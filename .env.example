# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Models. Defaults to Claude Opus 5.5 everywhere. For a much cheaper bulk-scoring
# step, set MODEL_SCORING=claude-haiku-5-5.
MODEL_MAIN=claude-opus-5-5
MODEL_SCORING=claude-opus-5-5

# Where the store sells and its currency.
MARKET=United Kingdom
CURRENCY=GBP

# Hard stop for one pipeline run, in US dollars of Claude usage.
MAX_RUN_COST_USD=3

# Shopify. Leave blank to run in dry-run mode (store data is saved to runs/ only).
# The app needs the write_products, write_content and read_orders scopes.
# Use EITHER an Admin API access token, OR a Dev Dashboard app's client id + secret.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
